{
  "Jwt": {
    "Key": "THIS_IS_MY_DEMO_SECRET_KEY_123456789",
    "Issuer": "MicroservicesDemo",
    "Audience": "MicroservicesDemoClient"
  },
  "ReverseProxy": {
    "Routes": {

      "product-route": {
        "ClusterId": "product-cluster",
        "AuthorizationPolicy": "authenticated",
        "RateLimiterPolicy": "api-policy",
        "Match": {
          "Path": "/api/products/{**catch-all}"
        }
      },

      "inventory-route": {
        "ClusterId": "inventory-cluster",
        "AuthorizationPolicy": "authenticated",
        "RateLimiterPolicy": "api-policy",
        "Match": {
          "Path": "/api/inventory/{**catch-all}"
        }
      }

    },

    "Clusters": {

      "product-cluster": {
        "Destinations": {
          "product-service": {
            "Address": "http://localhost:5002/"
          }
        }
      },

      "inventory-cluster": {
        "Destinations": {
          "inventory-service": {
            "Address": "http://localhost:5003/"
          }
        }
      }

    }
  }
}