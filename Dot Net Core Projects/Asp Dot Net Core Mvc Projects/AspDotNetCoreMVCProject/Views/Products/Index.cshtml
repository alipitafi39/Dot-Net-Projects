@model IEnumerable<AspDotNetCoreMVCProject.Models.Product>

@{
    ViewData["Title"] = "Products";
}

<div class="container-fluid py-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-box-seam"></i>
                Product Inventory
            </h2>

            <p class="text-muted mb-0">
                Manage your products
            </p>
        </div>

        <a asp-action="Create"
           class="btn btn-primary btn-lg shadow-sm">

            <i class="bi bi-plus-lg me-1"></i>

            Add Product

        </a>

    </div>


    <!-- Success Message -->

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm">

            <i class="bi bi-check-circle-fill me-2"></i>

            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- Search -->

    <div class="card border-0 shadow-sm mb-4">

        <div class="card-body">

            <form asp-action="Index"
                  method="get"
                  class="row g-3">

                <div class="col-md-10">

                    <div class="input-group input-group-lg">

                        <span class="input-group-text bg-white">

                            <i class="bi bi-search"></i>

                        </span>

                        <input type="text"
                               name="search"
                               value="@ViewBag.Search"
                               class="form-control"
                               placeholder="Search product, category or supplier..." />

                    </div>

                </div>

                <div class="col-md-2">

                    <button type="submit"
                            class="btn btn-dark btn-lg w-100">

                        <i class="bi bi-search me-1"></i>

                        Search

                    </button>

                </div>

            </form>

        </div>

    </div>


    <!-- Grid -->

    <div class="card border-0 shadow-lg">

        <div class="card-header bg-white border-0 p-4">

            <div class="d-flex justify-content-between align-items-center">

                <h5 class="fw-bold mb-0">

                    <i class="bi bi-grid me-2"></i>

                    Product List

                </h5>

                <span class="badge bg-primary rounded-pill px-3 py-2">

                    @Model.Count() Products

                </span>

            </div>

        </div>


        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-dark">

                        <tr>

                            <th class="ps-4">
                                #
                            </th>

                            <th>
                                Product
                            </th>

                            <th>
                                Category
                            </th>

                            <th>
                                Price
                            </th>

                            <th>
                                Quantity
                            </th>

                            <th>
                                Supplier
                            </th>

                            <th>
                                Created
                            </th>

                            <th class="text-center">
                                Actions
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @if (!Model.Any())
                        {
                            <tr>

                                <td colspan="8"
                                    class="text-center py-5">

                                    <i class="bi bi-inbox fs-1 text-muted"></i>

                                    <h5 class="mt-3">
                                        No products found
                                    </h5>

                                    <p class="text-muted">
                                        No product records are available.
                                    </p>

                                    <a asp-action="Create"
                                       class="btn btn-primary">

                                        <i class="bi bi-plus-lg me-1"></i>

                                        Add Product

                                    </a>

                                </td>

                            </tr>
                        }
                        else
                        {
                            int counter = 1;

                            foreach (var item in Model)
                            {
                                <tr>

                                    <!-- Number -->

                                    <td class="ps-4 fw-semibold">

                                        @counter

                                    </td>


                                    <!-- Product -->

                                    <td>

                                        <div class="d-flex align-items-center">

                                            <div class="product-icon me-3">

                                                <i class="bi bi-box"></i>

                                            </div>

                                            <div>

                                                <div class="fw-bold">

                                                    @item.ProductName

                                                </div>

                                                <small class="text-muted">

                                                    ID: #@item.ProductId

                                                </small>

                                            </div>

                                        </div>

                                    </td>


                                    <!-- Category -->

                                    <td>

                                        <span class="badge bg-light text-dark border">

                                            <i class="bi bi-tag me-1"></i>

                                            @item.Category.CategoryName

                                        </span>

                                    </td>


                                    <!-- Price -->

                                    <td class="fw-bold">

                                        Rs. @item.Price.ToString("N2")

                                    </td>


                                    <!-- Quantity -->

                                    <td>

                                        @if (item.Quantity > 10)
                                        {
                                            <span class="badge bg-success">

                                                @item.Quantity

                                            </span>
                                        }
                                        else if (item.Quantity > 0)
                                        {
                                            <span class="badge bg-warning text-dark">

                                                @item.Quantity

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">

                                                Out of Stock

                                            </span>
                                        }

                                    </td>


                                    <!-- Supplier -->

                                    <td>

                                        @if (!string.IsNullOrWhiteSpace(item.SupplierName))
                                        {
                                            <span>

                                                @item.SupplierName

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                N/A
                                            </span>
                                        }

                                    </td>


                                    <!-- Created -->

                                    <td>

                                        <small class="text-muted">

                                            @item.CreatedDate.ToString("dd MMM yyyy")

                                        </small>

                                    </td>


                                    <!-- Actions -->

                                    <td class="text-center">

                                        <div class="btn-group">

                                            <a asp-action="Details"
                                               asp-route-id="@item.ProductId"
                                               class="btn btn-sm btn-outline-info"
                                               title="View">

                                                <i class="bi bi-eye"></i>

                                            </a>


                                            <a asp-action="Edit"
                                               asp-route-id="@item.ProductId"
                                               class="btn btn-sm btn-outline-primary"
                                               title="Edit">

                                                <i class="bi bi-pencil"></i>

                                            </a>


                                            <a asp-action="Delete"
                                               asp-route-id="@item.ProductId"
                                               class="btn btn-sm btn-outline-danger"
                                               title="Delete">

                                                <i class="bi bi-trash"></i>

                                            </a>

                                        </div>

                                    </td>

                                </tr>

                                counter++;
                            }
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>